# Copy to .env and adjust. Docker Compose reads this file automatically.

# Postgres
POSTGRES_USER=emerge
POSTGRES_PASSWORD=emerge_dev_password
POSTGRES_DB=emerge
DATABASE_URL=postgres://emerge:emerge_dev_password@localhost:5432/emerge

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=emerge
S3_SECRET_KEY=emerge_dev_secret
S3_BUCKET=emerge

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
