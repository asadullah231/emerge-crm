# Emerge CRM - production environment file.
# On the VPS this lives at /opt/emerge/.env (root:root, 600).
# Copy this template, then fill in real secrets from D:/Projects/.secrets/master.env
# (block EMERGE_PROD_*). Never commit the filled file.

# ---- Postgres ----------------------------------------------------------------
POSTGRES_USER=emerge
POSTGRES_PASSWORD=change-me-32-chars
POSTGRES_DB=emerge

# ---- Redis -------------------------------------------------------------------
REDIS_PASSWORD=change-me-32-chars

# ---- MinIO (S3-compatible storage for candidate CVs) -------------------------
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-32-chars
S3_BUCKET=emerge
S3_REGION=us-east-1

# ---- Transactional email (Resend) -------------------------------------------
# Resend SMTP relay: https://resend.com/docs/send-with-smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=re_xxxxxxxxxxxx
SMTP_FROM=Emerge CRM <no-reply@emergeautomation.tech>

# ---- Resume parsing (M7, Claude) --------------------------------------------
# The worker sends CVs to Claude for structured extraction.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
PARSE_MODEL=claude-sonnet-5

# ---- Traefik / Let's Encrypt -------------------------------------------------
LETSENCRYPT_EMAIL=meldeeb@emergetech.co.uk

# ---- Off-site backup (Cloudflare R2) ----------------------------------------
# See: https://developers.cloudflare.com/r2/api/s3/tokens/
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key
R2_BUCKET=emerge-crm-backup
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_MONTHLY=12
BACKUP_SCHEDULE_HOUR_UTC=2

# ---- Image pinning (optional) -----------------------------------------------
# Bump when we cut a new release so pulls are reproducible.
IMAGE_TAG=v0.8.0
