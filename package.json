{
  "name": "emerge-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Emerge CRM: modern open-source Recruitment CRM / ATS for staffing agencies",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @emerge/web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @emerge/web test:e2e",
    "build": "pnpm -r --if-present build",
    "db:generate": "pnpm --filter @emerge/db generate",
    "db:migrate": "pnpm --filter @emerge/db migrate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0"
  }
}
